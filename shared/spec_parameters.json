{
  "_comment": "Standard spec parameters. 'match' is a regular expression tested against the start of the English label in the manual. 'type': number = one value or a range; dimensions = L x W x H; text = no numbers. 'unit' is the unit numbers are converted to. 'better' tells rankings which direction is good.",
  "parameters": [
    {"key": "min_passage_width",   "type": "number", "unit": "cm",   "better": "lower",
     "match": "min(imum|\\.)? (travel|passing) width|min\\.? path clearance",
     "labels": {"en": "Min. passage width", "de": "Min. Durchfahrtsbreite", "it": "Larghezza min. di passaggio"}},
    {"key": "max_load",            "type": "number", "unit": "kg",   "better": "higher",
     "match": "max\\.? load",
     "labels": {"en": "Max. load", "de": "Max. Traglast", "it": "Carico max."}},
    {"key": "load_per_tray",       "type": "number", "unit": "kg",   "better": "higher",
     "match": "tray load|tray supporting capacity",
     "labels": {"en": "Load per tray", "de": "Traglast pro Tablett", "it": "Carico per vassoio"}},
    {"key": "tray_count",          "type": "number", "unit": "",     "better": "higher",
     "match": "(no\\.|number) of trays",
     "labels": {"en": "Number of trays", "de": "Anzahl Tabletts", "it": "Numero di vassoi"}},
    {"key": "battery_runtime",     "type": "number", "unit": "h",    "better": "higher",
     "match": "battery life|runtime|operation time of batteries",
     "labels": {"en": "Battery life", "de": "Akkulaufzeit", "it": "Autonomia"}},
    {"key": "charging_time",       "type": "number", "unit": "h",    "better": "lower",
     "match": "charging time",
     "labels": {"en": "Charging time", "de": "Ladezeit", "it": "Tempo di ricarica"}},
    {"key": "battery_capacity",    "type": "number", "unit": "Ah",   "better": "higher",
     "match": "battery capacity|battery$",
     "labels": {"en": "Battery capacity", "de": "Akkukapazität", "it": "Capacità batteria"}},
    {"key": "weight",              "type": "number", "unit": "kg",   "better": "none",
     "match": "(robot |body |overall |product )?weight(?! \\(without)",
     "labels": {"en": "Weight", "de": "Gewicht", "it": "Peso"}},
    {"key": "dimensions",          "type": "dimensions", "unit": "mm", "better": "none",
     "match": "(robot |overall |product )?dimensions(?! \\(without)|body size",
     "labels": {"en": "Dimensions (L×W×H)", "de": "Abmessungen (L×B×H)", "it": "Dimensioni (L×P×A)"}},
    {"key": "speed",               "type": "number", "unit": "m/s",  "better": "higher",
     "match": "cruise speed|max\\.? moving speed",
     "labels": {"en": "Speed", "de": "Geschwindigkeit", "it": "Velocità"}},
    {"key": "max_obstacle_height", "type": "number", "unit": "mm",   "better": "higher",
     "match": "max(imum|\\.)? surmountable height",
     "labels": {"en": "Max. obstacle height", "de": "Max. überwindbare Höhe", "it": "Altezza max. superabile"}},
    {"key": "max_gap",             "type": "number", "unit": "mm",   "better": "higher",
     "match": "max(imum|\\.)? surmountable gap",
     "labels": {"en": "Max. gap", "de": "Max. überwindbarer Spalt", "it": "Fessura max. superabile"}},
    {"key": "max_climbing_angle",  "type": "number", "unit": "°",    "better": "higher",
     "match": "max(imum|\\.)? climbing angle",
     "labels": {"en": "Max. climbing angle", "de": "Max. Steigungswinkel", "it": "Pendenza max."}},
    {"key": "ip_rating",           "type": "text",   "unit": "",     "better": "none",
     "match": "ip rating",
     "labels": {"en": "IP rating", "de": "Schutzart", "it": "Grado IP"}},
    {"key": "cleaning_width",      "type": "number", "unit": "cm",   "better": "higher",
     "match": "cleaning width|working width",
     "labels": {"en": "Cleaning width", "de": "Reinigungsbreite", "it": "Larghezza di pulizia"}},
    {"key": "productivity",        "type": "number", "unit": "m²/h", "better": "higher",
     "match": "productivity|cleaning efficiency|cover cleaning",
     "labels": {"en": "Cleaning productivity", "de": "Flächenleistung", "it": "Produttività di pulizia"}},
    {"key": "noise",               "type": "number", "unit": "dB",   "better": "lower",
     "match": "working noise",
     "labels": {"en": "Working noise", "de": "Betriebsgeräusch", "it": "Rumorosità"}},
    {"key": "dustbin_capacity",    "type": "number", "unit": "L",    "better": "higher",
     "match": "dustbin capacity",
     "labels": {"en": "Dustbin capacity", "de": "Staubbehälter", "it": "Capacità contenitore polvere"}},
    {"key": "solution_tank",       "type": "number", "unit": "L",    "better": "higher",
     "match": "solution tank capacity",
     "labels": {"en": "Clean water tank", "de": "Frischwassertank", "it": "Serbatoio acqua pulita"}},
    {"key": "recovery_tank",       "type": "number", "unit": "L",    "better": "higher",
     "match": "recovery tank capacity",
     "labels": {"en": "Dirty water tank", "de": "Schmutzwassertank", "it": "Serbatoio acqua sporca"}},
    {"key": "navigation",          "type": "text",   "unit": "",     "better": "none",
     "match": "navigation|positioning mode",
     "labels": {"en": "Navigation", "de": "Navigation", "it": "Navigazione"}},
    {"key": "screen",              "type": "text",   "unit": "",     "better": "none",
     "match": "screen (size|specifications|type)",
     "labels": {"en": "Screen", "de": "Bildschirm", "it": "Schermo"}}
  ],
  "units": {
    "_comment": "factor to convert a printed unit into the parameter's unit: value * factor",
    "cm":  {"mm": 0.1, "cm": 1, "m": 100},
    "mm":  {"mm": 1, "cm": 10, "m": 1000},
    "kg":  {"kg": 1, "g": 0.001},
    "h":   {"h": 1, "hour": 1, "hours": 1, "min": 0.0166667, "mins": 0.0166667, "minutes": 0.0166667},
    "Ah":  {"ah": 1},
    "m/s": {"m/s": 1},
    "°":   {"°": 1, "º": 1},
    "m²/h": {"m²/h": 1, "㎡/h": 1, "m2/h": 1},
    "dB":  {"db": 1},
    "L":   {"l": 1}
  }
}
