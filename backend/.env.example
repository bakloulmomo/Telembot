# Copia questo file in .env e modifica solo ciò che serve.

# Cartella dei manuali (predefinita: ../data rispetto a backend/)
# DATA_DIR=../data

# Motore RAG: mock (finto, incluso) · python · http
RAG_ENGINE=mock

# RAG_ENGINE=python → funzione "modulo:funzione", importata dalla radice del progetto
# RAG_PYTHON=rag.pipeline:answer
# RAG_PYTHON_SEARCH=rag.pipeline:search        (facoltativo, per /api/search)

# RAG_ENGINE=http → servizio esterno che riceve POST {"question","history","lang","product_ids"}
# RAG_URL=http://localhost:9000/ask
# RAG_SEARCH_URL=http://localhost:9000/search  (facoltativo, per /api/search)

# Secondi di attesa massima della risposta del RAG
RAG_TIMEOUT_S=60

# Origini del frontend ammesse (CORS), in formato JSON
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
